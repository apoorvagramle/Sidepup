{
  "manifest_version": 3,
  "name": "Sidepup",
  "version": "2.10.8",
  "description": "A tiny golden retriever on your screen that keeps your tasks, a Pomodoro timer and gentle stretch and water reminders.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Sidepup",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/core.js",
        "content/liquid-glass.js",
        "content/pup.js",
        "content/styles.js",
        "content/companion.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "commands": {
    "toggle-hide": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Hide or show Sidepup"
    }
  }
}